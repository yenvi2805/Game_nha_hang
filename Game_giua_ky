<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đồ Án Giữa Kỳ: Siêu Đầu Bếp Nhà Hàng</title>
    <style>
        body { font-family: sans-serif; background: linear-gradient(135deg, #74b9ff, #a29bfe); margin: 0; padding: 20px; display: flex; flex-direction: column; align-items: center; }
        .container { background: white; padding: 20px; border-radius: 16px; max-width: 500px; width: 100%; text-align: center; box-shadow: 0 10px 20px rgba(0,0,0,0.1); }
        h1 { color: #d63031; font-size: 22px; }
        .stats { display: flex; justify-content: space-around; background: #f1f2f6; padding: 10px; border-radius: 8px; font-weight: bold; margin-bottom: 15px; }
        .order-card { background: #ffeaa7; border: 2px dashed #fdcb6e; padding: 15px; border-radius: 10px; margin-bottom: 15px; }
        .timer-bar { height: 8px; background: #00b894; width: 100%; border-radius: 4px; margin-top: 10px; transition: width 0.1s linear; }
        .kitchen-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-bottom: 15px; }
        .btn-item { background: #ff6b6b; color: white; border: none; padding: 15px; font-size: 16px; font-weight: bold; border-radius: 10px; }
        .btn-action { background: #00b894; color: white; border: none; padding: 12px 25px; font-size: 16px; font-weight: bold; border-radius: 8px; width: 100%; }
    </style>
</head>
<body>
    <div class="container">
        <h1>🍳 Siêu Đầu Bếp Nhà Hàng</h1>
        <p style="font-size:12px; color:#636e72;">Bài Tập Giữa Kỳ - Game Quản Lý Nấu Ăn</p>
        <div class="stats">
            <div>Điểm: <span id="score">0</span></div>
            <div>Level: <span id="level">1</span></div>
            <div>Mạng: <span id="lives">❤️❤️❤️</span></div>
        </div>
        <div class="order-card">
            <div style="font-size: 12px; color: #b71540; font-weight: bold;">KHÁCH ĐANG GỌI MÓN:</div>
            <div id="customer-order" style="font-size: 20px; font-weight: bold; margin: 8px 0;">...</div>
            <div class="timer-bar" id="timer-bar"></div>
        </div>
        <div style="margin-bottom:10px; font-weight:bold;">Đã chọn: <span id="current-selection" style="color:#0984e3;">Chưa có</span></div>
        <div class="kitchen-grid">
            <button class="btn-item" style="background:#e17055;" onclick="selectIngredient('🍕 Pizza')">🍕 Pizza</button>
            <button class="btn-item" style="background:#d63031;" onclick="selectIngredient('🍔 Burger')">🍔 Burger</button>
            <button class="btn-item" style="background:#0984e3;" onclick="selectIngredient('🥤 Đồ uống')">🥤 Đồ uống</button>
            <button class="btn-item" style="background:#6c5ce7;" onclick="selectIngredient('🍨 Kem/Tráng miệng')">🍨 Kem</button>
        </div>
        <button class="btn-action" onclick="serveOrder()">PHỤC VỤ KHÁCH</button>
    </div>
    <script>
        const items = ['🍕 Pizza', '🍔 Burger', '🥤 Đồ uống', '🍨 Kem/Tráng miệng'];
        let currentOrder = '', selectedItem = '', score = 0, level = 1, lives = 3, timeLeft = 100, gameInterval, gameSpeed = 4000;
        function nextOrder() {
            currentOrder = items[Math.floor(Math.random() * items.length)];
            document.getElementById('customer-order').innerText = currentOrder;
            selectedItem = '';
            document.getElementById('current-selection').innerText = 'Chưa có';
            clearInterval(gameInterval);
            timeLeft = 100;
            let timeStep = 100 / ((gameSpeed - (level * 250)) / 100);
            if(timeStep < 2) timeStep = 4;
            gameInterval = setInterval(() => {
                timeLeft -= timeStep;
                document.getElementById('timer-bar').style.width = timeLeft + '%';
                if (timeLeft <= 0) { clearInterval(gameInterval); handleFail("Hết giờ! Khách bỏ đi!"); }
            }, 100);
        }
        function selectIngredient(item) { selectedItem = item; document.getElementById('current-selection').innerText = selectedItem; }
        function serveOrder() {
            if (!selectedItem) { alert("Chưa chọn món!"); return; }
            clearInterval(gameInterval);
            if (selectedItem === currentOrder) {
                score += 10;
                document.getElementById('score').innerText = score;
                level = Math.floor(score / 40) + 1;
                document.getElementById('level').innerText = level;
                alert("✨ Thành công!");
                nextOrder();
            } else { handleFail("Sai món rồi!"); }
        }
        function handleFail(msg) {
            lives--;
            let h = ""; for(let i=0; i<lives; i++) h += "❤️";
            document.getElementById('lives').innerText = h || "💔 Hết mạng";
            alert(msg);
            if (lives <= 0) { alert("Game Over! Điểm: " + score); score = 0; level = 1; lives = 3; document.getElementById('score').innerText = 0; document.getElementById('level').innerText = 1; document.getElementById('lives').innerText = "❤️❤️❤️"; }
            nextOrder();
        }
        nextOrder();
    </script>
</body>
</html>
